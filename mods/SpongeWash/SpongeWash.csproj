<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SpongeWash</AssemblyName>
    <RootNamespace>SpongeWash</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>

    <!-- Caminho do jogo: ajuste se o Nomad Drive estiver em outra biblioteca Steam -->
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Nomad Drive</GameDir>
    <ManagedDir>$(GameDir)\Nomad Drive_Data\Managed</ManagedDir>
    <!-- dotnet build -p:CopyToGame=false compila sem mexer no jogo instalado -->
    <CopyToGame Condition="'$(CopyToGame)' == ''">true</CopyToGame>
  </PropertyGroup>

  <ItemGroup>
    <!-- Só para compilar a entrada do BepInEx; quem roda o mod usa o BepInEx do BepInExPack_NomadDrive -->
    <Reference Include="BepInEx" HintPath="lib\BepInEx.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="EvilCore.Inputs" HintPath="$(ManagedDir)\EvilCore.Inputs.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="Mirror" HintPath="$(ManagedDir)\Mirror.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="$(ManagedDir)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
  </ItemGroup>

  <!-- Depois de compilar, copia o mod direto para BepInEx\plugins (BepInExPack_NomadDrive) -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(CopyToGame)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\SpongeWash" />
  </Target>

</Project>
